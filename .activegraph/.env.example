# DSKT ActiveGraph — copy to .activegraph/.env and adjust.
# Restart ./.activegraph/start.sh after any change to this file.

# Path to your activegraph-packs checkout (default: ~/Local/activegraph-packs)
# ACTIVEGRAPH_PACKS_ROOT=/Users/you/Local/activegraph-packs

# Isolated SQLite stores for this repo (default: .activegraph/data/*.sqlite)
# ACTIVEGRAPH_DB=
# ACTIVEGRAPH_MEMORY_DB=

# Project identity
DSKT_PROJECT_NAME=DSKT
DSKT_PROJECT_SLUG=dskt
# GitLab path_with_namespace for glab issue lookups (required for fetch_gitlab_issue)
# DSKT_GITLAB_PROJECT=your-group/dskt

# ── MCP auth (server side) ───────────────────────────────────────────────────
#
# Format:  bearer-secret:caller-identifier  (comma-separated for multiple clients)
#
#   bearer-secret       → must match "Authorization: Bearer …" in the harness MCP config
#   caller-identifier   → labels who is calling (memory scoping, audit trail)
#
# CRITICAL: If ACTIVEGRAPH_OWNER is set, every identifier you use MUST appear in
# that list — otherwise MCP returns "invalid token".
#
# Suggested identifiers per harness (pick one row, or register all for multi-harness):
#
#   Harness        Identifier     Harness MCP config file
#   ─────────────────────────────────────────────────────────────────────────
#   Cursor         cursor         .cursor/mcp.json
#   Claude Code    claude-code    .mcp.json (repo root)
#   Antigravity    antigravity    .agents/mcp_config.json
#   Codex          codex          (tool-specific MCP settings)
#
# Single harness (Cursor only; generate a random secret):
#   ACTIVEGRAPH_MCP_TOKENS=replace-with-random-token:cursor
#   ACTIVEGRAPH_OWNER=cursor
#
# Multiple harnesses (same bearer secret, different identifiers):
#   ACTIVEGRAPH_MCP_TOKENS=replace-with-random-token:cursor,replace-with-random-token:claude-code,replace-with-random-token:antigravity
#   ACTIVEGRAPH_OWNER=cursor,claude-code,antigravity
#
# Solo local dev (simplest — omit ACTIVEGRAPH_OWNER entirely):
#   ACTIVEGRAPH_MCP_TOKENS=replace-with-random-token:cursor
#
ACTIVEGRAPH_MCP_TOKENS=replace-with-random-token:cursor
ACTIVEGRAPH_OWNER=cursor

# Optional: same bearer value for harness MCP configs (Cursor ${env:…} interpolation)
DSKT_ACTIVEGRAPH_TOKEN=replace-with-random-token

# Reply policy: open | known | owner_only (use known/owner_only before exposing MCP)
ACTIVEGRAPH_REPLY_POLICY=open

# Ports (must match how you start the stack)
API_PORT=8088
UI_PORT=3000
ACTIVEGRAPH_PORT=7788

# Optional: live LLM for chat (otherwise mock mode)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: outbound MCP servers (JSON array)
# ACTIVEGRAPH_MCP_SERVERS='[{"name":"gitlab","transport":"stdio","command":["npx","-y","..."]}]'
