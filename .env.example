# Local Compose bootstrap only. These are not production credentials.
POSTGRES_USER=dskt
POSTGRES_PASSWORD=dskt-local-only
POSTGRES_DB=dskt

# Host ports when other stacks use 5433 / 3000 / 8080 (override if still in use)
DSKT_POSTGRES_HOST_PORT=5436
DSKT_BACKEND_HOST_PORT=3001
DSKT_FRONTEND_HOST_PORT=8082
